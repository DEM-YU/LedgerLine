# Copy to .env for local development. Never commit real secrets.

# Migration / schema owner connection (PostgreSQL owner role)
DATABASE_OWNER_URL=postgresql+asyncpg://ledgerline_owner:dev_owner_password@localhost:5433/ledgerline

# Application runtime connection (non-owner role without BYPASSRLS)
DATABASE_URL=postgresql+asyncpg://ledgerline_app:dev_app_password@localhost:5433/ledgerline

# Logging and service metadata
LOG_LEVEL=INFO
ENVIRONMENT=development
